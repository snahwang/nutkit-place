<header class="mb-8">
  <div class="flex items-center gap-4">
    <img src="/logo-title.jpg" alt="Zarket Places" class="h-14 w-14 md:h-16 md:w-16 rounded-2xl border border-white/10 bg-white" />
    <h1 class="text-3xl md:text-4xl font-bold tracking-tight">ZarketPlaces</h1>
  </div>
  <p class="text-slate-400 mt-2">사내 AI 자산(MCP, Skill, Plugin, Prompt)을 한 곳에서 검색하고 공유합니다.</p>
</header>

<section class="mb-8">
  <form method="GET" action="/" class="rounded-2xl bg-white/5 border border-white/10 p-4 md:p-5 shadow-[0_0_0_1px_rgba(255,255,255,0.06),0_20px_50px_rgba(0,0,0,0.45)]">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
      <div class="md:col-span-2">
        <label class="text-xs text-slate-400">search</label>
        <input
          type="text"
          name="q"
          value="{{q}}"
          placeholder="예: claude mcp, logging, payment..."
          class="mt-1 w-full rounded-xl bg-slate-900/60 border border-white/10 px-4 py-3 text-slate-100 placeholder:text-slate-500 focus:outline-none focus:ring-2 focus:ring-orange-500/60"
        />
      </div>

      <div>
        <label class="text-xs text-slate-400">type</label>
        <select name="type" class="mt-1 w-full rounded-xl bg-slate-900/60 border border-white/10 px-4 py-3 text-slate-100 focus:outline-none focus:ring-2 focus:ring-orange-500/60">
          <option value="" {{#unless type}}selected{{/unless}}>all</option>
          <option value="MCP" {{#ifEq type "MCP"}}selected{{/ifEq}}>MCP</option>
          <option value="Skill" {{#ifEq type "Skill"}}selected{{/ifEq}}>Skill</option>
          <option value="Plugin" {{#ifEq type "Plugin"}}selected{{/ifEq}}>Plugin</option>
          <option value="Prompt" {{#ifEq type "Prompt"}}selected{{/ifEq}}>Prompt</option>
        </select>
      </div>

    </div>

    <div id="tag-hidden">
      {{#each tags}}
        <input type="hidden" name="tag" value="{{this}}" />
      {{/each}}
    </div>
    <div class="mt-4 space-y-2">
      {{#each filterTagGroups}}
      <div class="flex flex-wrap items-center gap-2">
        <span class="text-[10px] text-slate-500 min-w-[56px]">{{this.groupName}}</span>
        {{#each this.tags}}
          {{#if (hasTag ../../tags this.tagId)}}
          <button type="button" data-tag="{{this.tagId}}" class="tag-chip px-3 py-1.5 rounded-full text-xs font-semibold bg-orange-500 text-black border border-orange-400">{{this.label}}</button>
          {{else}}
          <button type="button" data-tag="{{this.tagId}}" class="tag-chip px-3 py-1.5 rounded-full text-xs bg-white/5 border border-white/10 text-slate-200 hover:border-orange-500/50">{{this.label}}</button>
          {{/if}}
        {{/each}}
      </div>
      {{/each}}
      <div class="flex items-center gap-2 pt-1">
        <div class="flex-1"></div>
        {{#if tags.length}}
        <button type="button" id="clear-tags" class="px-3 py-1.5 rounded-lg border border-white/10 text-xs text-slate-400 hover:text-slate-200 hover:border-white/20">clear tags</button>
        {{/if}}
        <button type="submit" class="px-4 py-2 rounded-xl bg-orange-500 text-black font-semibold hover:bg-orange-400">apply</button>
      </div>
    </div>
    <script>
    (function() {
      var form = document.querySelector('form');
      var wrap = document.getElementById('tag-hidden');

      function getSelected() {
        return Array.from(wrap.querySelectorAll('input[name="tag"]')).map(function(i){ return i.value; });
      }
      function setAndSubmit(values) {
        wrap.innerHTML = '';
        values.forEach(function(v){
          var input = document.createElement('input');
          input.type = 'hidden'; input.name = 'tag'; input.value = v;
          wrap.appendChild(input);
        });
        form.submit();
      }

      document.querySelectorAll('.tag-chip').forEach(function(btn) {
        btn.addEventListener('click', function() {
          var selected = new Set(getSelected());
          if (selected.has(btn.dataset.tag)) selected.delete(btn.dataset.tag);
          else selected.add(btn.dataset.tag);
          setAndSubmit(Array.from(selected));
        });
      });

      var clearBtn = document.getElementById('clear-tags');
      if (clearBtn) clearBtn.addEventListener('click', function(){ setAndSubmit([]); });
    })();
    </script>
  </form>
</section>

<section>
  <div class="flex items-center justify-end mb-4">
    <div class="flex items-center gap-2">
      <label class="text-xs text-slate-500">sort</label>
      <select id="sort-select" class="rounded-lg bg-slate-900/60 border border-white/10 px-3 py-1.5 text-xs text-slate-200 focus:outline-none focus:ring-2 focus:ring-orange-500/60">
        <option value="latest" {{#ifEq sort "latest"}}selected{{/ifEq}}>latest</option>
        <option value="stars" {{#ifEq sort "stars"}}selected{{/ifEq}}>stars</option>
        <option value="name_asc" {{#ifEq sort "name_asc"}}selected{{/ifEq}}>name (A-Z)</option>
        <option value="name_desc" {{#ifEq sort "name_desc"}}selected{{/ifEq}}>name (Z-A)</option>
      </select>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
    {{#each items}}
      <a href="/items/{{this.itemId}}" class="group block rounded-2xl bg-white/5 border border-white/10 p-5 shadow-[0_0_0_1px_rgba(255,255,255,0.06),0_20px_50px_rgba(0,0,0,0.45)] hover:shadow-[0_0_0_1px_rgba(249,115,22,0.35),0_10px_30px_rgba(0,0,0,0.35)] transition">
        <div class="flex items-start justify-between gap-3">
          <div class="min-w-0">
            <div class="flex items-center gap-2">
              <span class="text-[11px] font-semibold tracking-wide uppercase px-2 py-1 rounded-full bg-white/5 border border-white/10 text-slate-300">{{this.type}}</span>
              <button type="button" class="star-toggle text-xs {{#if this.starred}}text-orange-400{{else}}text-slate-500{{/if}} hover:text-orange-300" data-item-id="{{this.itemId}}">★ <span class="star-count">{{this.starCount}}</span></button>
            </div>
            <h3 class="mt-3 text-lg font-semibold text-slate-100 group-hover:text-white truncate">{{this.name}}</h3>
            <p class="mt-2 text-sm text-slate-400 line-clamp-3">{{this.description}}</p>
          </div>

          <div class="shrink-0 h-11 w-11 rounded-xl bg-slate-900 border border-white/10 flex items-center justify-center text-slate-300">
            {{#if this.icon}}
              <span class="text-xl">{{this.icon}}</span>
            {{else}}
              <span class="text-sm font-bold">Z</span>
            {{/if}}
          </div>
        </div>

        <div class="mt-4 flex flex-wrap gap-2">
          {{#each this.tags}}
            <span class="text-xs px-2 py-1 rounded-full bg-slate-900/60 border border-white/10 text-slate-300">{{this}}</span>
          {{/each}}
        </div>

        <div class="mt-5 flex items-center justify-between">
          <span class="text-xs text-slate-500">{{this.authorName}}</span>
          <span class="text-sm font-semibold px-3 py-1.5 rounded-lg bg-orange-500 text-black group-hover:bg-orange-400">open</span>
        </div>
      </a>
    {{else}}
      <div class="col-span-full text-center py-16 rounded-2xl bg-white/5 border border-white/10">
        <p class="text-slate-400">No items yet.</p>
        <a href="/items/new" class="inline-block mt-4 px-4 py-2 rounded-xl bg-orange-500 text-black font-semibold hover:bg-orange-400">register first tool</a>
      </div>
    {{/each}}
  </div>

  {{#if nextUrl}}
  <div class="mt-8 flex justify-center">
    <a href="{{nextUrl}}" class="px-6 py-2.5 rounded-xl bg-white/5 border border-white/10 text-sm text-slate-200 hover:border-orange-500/50 hover:text-white transition">Next &rarr;</a>
  </div>
  {{/if}}
</section>

<script>
(function() {
  var sortSelect = document.getElementById('sort-select');
  if (sortSelect) {
    sortSelect.addEventListener('change', function() {
      var params = new URLSearchParams(window.location.search);
      params.delete('cursor');
      var val = sortSelect.value;
      if (val && val !== 'latest') {
        params.set('sort', val);
      } else {
        params.delete('sort');
      }
      var qs = params.toString();
      window.location.href = '/' + (qs ? '?' + qs : '');
    });
  }

  document.querySelectorAll('.star-toggle').forEach(function(btn) {
    btn.addEventListener('click', function(e) {
      e.preventDefault();
      e.stopPropagation();
      fetch('/api/items/' + btn.dataset.itemId + '/star', { method: 'POST' })
        .then(function(r) {
          if (r.status === 401) { window.location.href = '/auth/google'; return null; }
          return r.json();
        })
        .then(function(data) {
          if (!data) return;
          var countEl = btn.querySelector('.star-count');
          if (countEl) countEl.textContent = data.starCount;
          if (data.starred) {
            btn.classList.add('text-orange-400');
            btn.classList.remove('text-slate-500');
          } else {
            btn.classList.remove('text-orange-400');
            btn.classList.add('text-slate-500');
          }
        });
    });
  });
})();
</script>
