<div class="mb-5">
  <a href="/" class="text-sm text-slate-300 hover:text-white">&larr; back</a>
</div>

<div class="rounded-2xl bg-white/5 border border-white/10 p-6 shadow-[0_0_0_1px_rgba(255,255,255,0.06),0_20px_50px_rgba(0,0,0,0.45)] max-w-4xl">
  <!-- Header -->
  <div class="flex items-start justify-between gap-4">
    <div class="min-w-0">
      <div class="flex items-center gap-2">
        <span class="text-[11px] font-semibold tracking-wide uppercase px-2 py-1 rounded-full bg-white/5 border border-white/10 text-slate-300">{{item.type}}</span>
        <span class="text-xs text-slate-500">&#9733; {{item.starCount}}</span>
        <span class="text-xs text-slate-600">{{item.viewCount}} views</span>
      </div>
      <h1 class="mt-3 text-2xl font-bold tracking-tight">{{item.name}}</h1>
      <p class="mt-2 text-slate-400">{{item.description}}</p>
    </div>

    {{#if user}}
    <a href="/items/{{item.itemId}}/edit" class="shrink-0 px-4 py-2 rounded-xl bg-white/5 border border-white/10 text-sm text-slate-200 hover:border-orange-500/50">edit</a>
    {{/if}}
  </div>

  <!-- Tags -->
  {{#if item.tags.length}}
  <div class="mt-4 flex flex-wrap gap-2">
    {{#each item.tags}}
    <span class="text-xs px-2 py-1 rounded-full bg-slate-900/60 border border-white/10 text-slate-300">{{this}}</span>
    {{/each}}
  </div>
  {{/if}}

  <!-- Install Actions (per-tool) -->
  {{#if hasInstallActions}}
  <div class="mt-6 border-t border-white/10 pt-6 space-y-4">
    <h2 class="text-sm font-semibold text-slate-200">install / apply</h2>

    {{#if item.installActions.claude_code}}
    <div class="rounded-xl bg-slate-900/60 border border-white/10 p-4">
      <div class="flex items-center gap-2 mb-3">
        <span class="text-xs font-semibold text-orange-400">Claude Code</span>
      </div>
      {{#if item.installActions.claude_code.command}}
      <div class="flex items-center gap-2 bg-black/30 rounded-lg p-3">
        <code class="flex-1 text-sm text-green-400 font-mono break-all">{{item.installActions.claude_code.command}}</code>
        <button class="copy-btn shrink-0 px-3 py-1.5 rounded-lg bg-white/5 border border-white/10 text-xs text-slate-200 hover:border-orange-500/50" data-copy="{{item.installActions.claude_code.command}}">copy</button>
      </div>
      {{/if}}
      {{#if item.installActions.claude_code.path}}
      <p class="mt-2 text-xs text-slate-500">Path: <code>{{item.installActions.claude_code.path}}</code></p>
      {{/if}}
      {{#if item.installActions.claude_code.notes}}
      <p class="mt-2 text-xs text-slate-400">{{item.installActions.claude_code.notes}}</p>
      {{/if}}
    </div>
    {{/if}}

    {{#if item.installActions.cursor}}
    <div class="rounded-xl bg-slate-900/60 border border-white/10 p-4">
      <div class="flex items-center gap-2 mb-3">
        <span class="text-xs font-semibold text-blue-400">Cursor</span>
      </div>
      {{#if item.installActions.cursor.command}}
      <div class="flex items-center gap-2 bg-black/30 rounded-lg p-3">
        <code class="flex-1 text-sm text-green-400 font-mono break-all">{{item.installActions.cursor.command}}</code>
        <button class="copy-btn shrink-0 px-3 py-1.5 rounded-lg bg-white/5 border border-white/10 text-xs text-slate-200 hover:border-orange-500/50" data-copy="{{item.installActions.cursor.command}}">copy</button>
      </div>
      {{/if}}
      {{#if item.installActions.cursor.url}}
      <a href="{{item.installActions.cursor.url}}" class="inline-block mt-2 px-4 py-2 rounded-lg bg-blue-600 text-white text-sm font-medium hover:bg-blue-500">Add to Cursor</a>
      {{/if}}
      {{#if item.installActions.cursor.path}}
      <p class="mt-2 text-xs text-slate-500">Path: <code>{{item.installActions.cursor.path}}</code></p>
      {{/if}}
      {{#if item.installActions.cursor.notes}}
      <p class="mt-2 text-xs text-slate-400">{{item.installActions.cursor.notes}}</p>
      {{/if}}
    </div>
    {{/if}}
  </div>
  {{/if}}

  <!-- Legacy installCommand fallback -->
  {{#if item.installCommand}}
  {{#unless hasInstallActions}}
  <div class="mt-6 border-t border-white/10 pt-6">
    <h2 class="text-sm font-semibold text-slate-200 mb-2">install command</h2>
    <div class="flex items-center gap-2 bg-black/30 rounded-lg p-3">
      <code class="flex-1 text-sm text-green-400 font-mono break-all">{{item.installCommand}}</code>
      <button class="copy-btn shrink-0 px-3 py-1.5 rounded-lg bg-white/5 border border-white/10 text-xs text-slate-200 hover:border-orange-500/50" data-copy="{{item.installCommand}}">copy</button>
    </div>
  </div>
  {{/unless}}
  {{/if}}

  <!-- Detail description -->
  {{#if item.detailDescription}}
  <div class="mt-6 border-t border-white/10 pt-6">
    <h2 class="text-sm font-semibold text-slate-200 mb-2">detail</h2>
    <div class="prose prose-invert max-w-none text-slate-200">
      <pre class="whitespace-pre-wrap text-sm bg-slate-900/60 border border-white/10 rounded-xl p-4">{{item.detailDescription}}</pre>
    </div>
  </div>
  {{/if}}

  <!-- GitHub link -->
  {{#if item.githubUrl}}
  <div class="mt-6 border-t border-white/10 pt-6">
    <a href="{{item.githubUrl}}" target="_blank" rel="noopener noreferrer" class="text-sm text-blue-400 hover:text-blue-300">GitHub Repository &rarr;</a>
  </div>
  {{/if}}

  <!-- Metadata -->
  <div class="mt-6 border-t border-white/10 pt-4 flex items-center gap-4 text-xs text-slate-500">
    <span>by {{item.authorName}}</span>
    <span>created {{item.createdAt}}</span>
  </div>

  <!-- Delete (only for logged-in users) -->
  {{#if user}}
  <div class="mt-6 border-t border-white/10 pt-4">
    <form action="/api/items/{{item.itemId}}/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this item?')">
      <button type="submit" class="text-xs text-red-400 hover:text-red-300">delete this item</button>
    </form>
  </div>
  {{/if}}
</div>

<script>
document.querySelectorAll('.copy-btn').forEach(function(btn) {
  btn.addEventListener('click', function() {
    navigator.clipboard.writeText(btn.dataset.copy || '');
    btn.textContent = 'copied!';
    setTimeout(function() { btn.textContent = 'copy'; }, 2000);
  });
});
</script>
