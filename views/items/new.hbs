<header class="mb-8">
  <h1 class="text-2xl md:text-3xl font-bold tracking-tight">register new item</h1>
  <p class="text-slate-400 mt-2">AI 도구를 등록합니다.</p>
</header>

<form action="/api/items" method="POST" enctype="multipart/form-data" class="rounded-2xl bg-white/5 border border-white/10 p-6 shadow-[0_0_0_1px_rgba(255,255,255,0.06),0_20px_50px_rgba(0,0,0,0.45)] max-w-3xl space-y-6">

  <!-- Basic info -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <label for="type" class="text-xs text-slate-400">type</label>
      <select id="type" name="type" class="mt-1 w-full rounded-xl bg-slate-900/60 border border-white/10 px-4 py-3 text-slate-100 focus:outline-none focus:ring-2 focus:ring-orange-500/60">
        <option value="MCP">MCP</option>
        <option value="Skill">Skill</option>
        <option value="Plugin">Plugin</option>
        <option value="Prompt">Prompt</option>
      </select>
    </div>
    <div>
      <label for="name" class="text-xs text-slate-400">name</label>
      <input id="name" name="name" required placeholder="e.g. payment-mcp" class="mt-1 w-full rounded-xl bg-slate-900/60 border border-white/10 px-4 py-3 text-slate-100 placeholder:text-slate-500 focus:outline-none focus:ring-2 focus:ring-orange-500/60" />
    </div>
    <div class="md:col-span-2">
      <label for="description" class="text-xs text-slate-400">short description</label>
      <input id="description" name="description" required placeholder="한 줄 설명" class="mt-1 w-full rounded-xl bg-slate-900/60 border border-white/10 px-4 py-3 text-slate-100 placeholder:text-slate-500 focus:outline-none focus:ring-2 focus:ring-orange-500/60" />
    </div>

    <!-- Tags (grouped checkboxes) -->
    <div class="md:col-span-2">
      <label class="text-xs text-slate-400">tags</label>
      {{#each tagGroups}}
      <div class="mt-3">
        <span class="text-xs font-medium text-slate-300">{{this.groupName}}</span>
        <div class="mt-1 flex flex-wrap gap-2">
          {{#each this.tags}}
          <label class="flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs cursor-pointer bg-white/5 border border-white/10 text-slate-200 hover:border-orange-500/50 has-[:checked]:bg-orange-500 has-[:checked]:text-black has-[:checked]:border-orange-400 has-[:checked]:font-semibold">
            <input type="checkbox" name="tags" value="{{this.tagId}}" class="sr-only" />
            {{this.label}}
          </label>
          {{/each}}
        </div>
      </div>
      {{/each}}
    </div>

    <div class="md:col-span-2">
      <label for="githubUrl" class="text-xs text-slate-400">github url (optional)</label>
      <input id="githubUrl" name="githubUrl" type="url" placeholder="https://github.com/..." class="mt-1 w-full rounded-xl bg-slate-900/60 border border-white/10 px-4 py-3 text-slate-100 placeholder:text-slate-500 focus:outline-none focus:ring-2 focus:ring-orange-500/60" />
    </div>
  </div>

  <!-- Detail description -->
  <div>
    <label for="detailDescription" class="text-xs text-slate-400">detail (markdown)</label>
    <textarea id="detailDescription" name="detailDescription" rows="6" placeholder="상세 설명 (Markdown)" class="mt-1 w-full rounded-xl bg-slate-900/60 border border-white/10 px-4 py-3 text-slate-100 placeholder:text-slate-500 focus:outline-none focus:ring-2 focus:ring-orange-500/60"></textarea>
    <div class="mt-2">
      <label class="text-xs text-slate-500">or upload .md file:</label>
      <input type="file" name="mdFile" accept=".md,.markdown,.txt" class="mt-1 block text-sm text-slate-400 file:mr-3 file:py-1.5 file:px-3 file:rounded-lg file:border file:border-white/10 file:bg-white/5 file:text-slate-200 file:text-xs hover:file:border-orange-500/50" />
    </div>
  </div>

  <!-- Install actions: Claude Code -->
  <fieldset class="border border-white/10 rounded-xl p-4">
    <legend class="text-xs font-semibold text-orange-400 px-2">Claude Code</legend>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
      <div class="md:col-span-2">
        <label class="text-xs text-slate-400">install command</label>
        <input name="claude_code_command" placeholder="claude mcp add my-tool -- npx ..." class="mt-1 w-full rounded-xl bg-slate-900/60 border border-white/10 px-4 py-2.5 text-sm text-slate-100 placeholder:text-slate-500 focus:outline-none focus:ring-2 focus:ring-orange-500/60" />
      </div>
      <div>
        <label class="text-xs text-slate-400">url (optional)</label>
        <input name="claude_code_url" placeholder="https://..." class="mt-1 w-full rounded-xl bg-slate-900/60 border border-white/10 px-4 py-2.5 text-sm text-slate-100 placeholder:text-slate-500 focus:outline-none focus:ring-2 focus:ring-orange-500/60" />
      </div>
      <div>
        <label class="text-xs text-slate-400">config path (optional)</label>
        <input name="claude_code_path" placeholder=".claude/mcp.json" class="mt-1 w-full rounded-xl bg-slate-900/60 border border-white/10 px-4 py-2.5 text-sm text-slate-100 placeholder:text-slate-500 focus:outline-none focus:ring-2 focus:ring-orange-500/60" />
      </div>
      <div class="md:col-span-2">
        <label class="text-xs text-slate-400">notes</label>
        <input name="claude_code_notes" placeholder="Requires Claude Code CLI v1.0+" class="mt-1 w-full rounded-xl bg-slate-900/60 border border-white/10 px-4 py-2.5 text-sm text-slate-100 placeholder:text-slate-500 focus:outline-none focus:ring-2 focus:ring-orange-500/60" />
      </div>
    </div>
  </fieldset>

  <!-- Install actions: Cursor -->
  <fieldset class="border border-white/10 rounded-xl p-4">
    <legend class="text-xs font-semibold text-blue-400 px-2">Cursor</legend>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
      <div class="md:col-span-2">
        <label class="text-xs text-slate-400">install command</label>
        <input name="cursor_command" placeholder="npx @scope/my-tool" class="mt-1 w-full rounded-xl bg-slate-900/60 border border-white/10 px-4 py-2.5 text-sm text-slate-100 placeholder:text-slate-500 focus:outline-none focus:ring-2 focus:ring-orange-500/60" />
      </div>
      <div>
        <label class="text-xs text-slate-400">url (e.g. cursor:// deep link)</label>
        <input name="cursor_url" placeholder="cursor://..." class="mt-1 w-full rounded-xl bg-slate-900/60 border border-white/10 px-4 py-2.5 text-sm text-slate-100 placeholder:text-slate-500 focus:outline-none focus:ring-2 focus:ring-orange-500/60" />
      </div>
      <div>
        <label class="text-xs text-slate-400">config path (optional)</label>
        <input name="cursor_path" placeholder=".cursor/mcp.json" class="mt-1 w-full rounded-xl bg-slate-900/60 border border-white/10 px-4 py-2.5 text-sm text-slate-100 placeholder:text-slate-500 focus:outline-none focus:ring-2 focus:ring-orange-500/60" />
      </div>
      <div class="md:col-span-2">
        <label class="text-xs text-slate-400">notes</label>
        <input name="cursor_notes" placeholder="Add to MCP settings in Cursor" class="mt-1 w-full rounded-xl bg-slate-900/60 border border-white/10 px-4 py-2.5 text-sm text-slate-100 placeholder:text-slate-500 focus:outline-none focus:ring-2 focus:ring-orange-500/60" />
      </div>
    </div>
  </fieldset>

  <div class="flex items-center gap-3">
    <button type="submit" class="px-5 py-2.5 rounded-xl bg-orange-500 text-black font-semibold hover:bg-orange-400">save</button>
    <a href="/" class="text-sm text-slate-300 hover:text-white">cancel</a>
  </div>
</form>
