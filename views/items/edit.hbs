<header class="mb-8">
  <h1 class="text-2xl md:text-3xl font-bold tracking-tight">edit item</h1>
  <p class="text-slate-400 mt-2">{{item.name}} 수정</p>
</header>

<form action="/api/items/{{item.itemId}}" method="POST" enctype="multipart/form-data" class="rounded-2xl bg-white/5 border border-white/10 p-6 shadow-[0_0_0_1px_rgba(255,255,255,0.06),0_20px_50px_rgba(0,0,0,0.45)] max-w-3xl space-y-6">

  <!-- Basic info -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <label for="type" class="text-xs text-slate-400">type</label>
      <select id="type" name="type" class="mt-1 w-full rounded-xl bg-slate-900/60 border border-white/10 px-4 py-3 text-slate-100 focus:outline-none focus:ring-2 focus:ring-orange-500/60">
        <option value="MCP" {{#ifEq item.type "MCP"}}selected{{/ifEq}}>MCP</option>
        <option value="Skill" {{#ifEq item.type "Skill"}}selected{{/ifEq}}>Skill</option>
        <option value="Plugin" {{#ifEq item.type "Plugin"}}selected{{/ifEq}}>Plugin</option>
        <option value="Prompt" {{#ifEq item.type "Prompt"}}selected{{/ifEq}}>Prompt</option>
      </select>
    </div>
    <div>
      <label for="name" class="text-xs text-slate-400">name</label>
      <input id="name" name="name" required value="{{item.name}}" class="mt-1 w-full rounded-xl bg-slate-900/60 border border-white/10 px-4 py-3 text-slate-100 focus:outline-none focus:ring-2 focus:ring-orange-500/60" />
    </div>
    <div class="md:col-span-2">
      <label for="description" class="text-xs text-slate-400">short description</label>
      <input id="description" name="description" required value="{{item.description}}" class="mt-1 w-full rounded-xl bg-slate-900/60 border border-white/10 px-4 py-3 text-slate-100 focus:outline-none focus:ring-2 focus:ring-orange-500/60" />
    </div>

    <!-- Tags (grouped checkboxes) -->
    <div class="md:col-span-2">
      <label class="text-xs text-slate-400">tags</label>
      {{#each tagGroups}}
      <div class="mt-3">
        <span class="text-xs font-medium text-slate-300">{{this.groupName}}</span>
        <div class="mt-1 flex flex-wrap gap-2">
          {{#each this.tags}}
          <label class="flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs cursor-pointer bg-white/5 border border-white/10 text-slate-200 hover:border-orange-500/50 has-[:checked]:bg-orange-500 has-[:checked]:text-black has-[:checked]:border-orange-400 has-[:checked]:font-semibold">
            <input type="checkbox" name="tags" value="{{this.tagId}}" {{#if (hasTag ../../item.tags this.tagId)}}checked{{/if}} class="sr-only" />
            {{this.label}}
          </label>
          {{/each}}
        </div>
      </div>
      {{/each}}
    </div>

    <!-- Icon picker -->
    <div class="md:col-span-2">
      <label class="text-xs text-slate-400">icon (emoji)</label>
      <div class="mt-1 flex flex-wrap gap-2 emoji-presets">
        {{#each emojiPresets}}
        <button type="button" data-emoji="{{this}}" class="emoji-btn w-10 h-10 rounded-xl bg-slate-900/60 border {{#ifEq this ../item.icon}}border-orange-400 bg-orange-500/20{{else}}border-white/10{{/ifEq}} text-lg flex items-center justify-center hover:border-orange-500/50">{{this}}</button>
        {{/each}}
      </div>
      <input id="icon" name="icon" maxlength="2" value="{{item.icon}}" placeholder="or type any emoji" class="mt-2 w-40 rounded-xl bg-slate-900/60 border border-white/10 px-4 py-2.5 text-center text-lg text-slate-100 focus:outline-none focus:ring-2 focus:ring-orange-500/60" />
    </div>

    <div class="md:col-span-2">
      <label for="githubUrl" class="text-xs text-slate-400">github url (optional)</label>
      <input id="githubUrl" name="githubUrl" type="url" value="{{item.githubUrl}}" class="mt-1 w-full rounded-xl bg-slate-900/60 border border-white/10 px-4 py-3 text-slate-100 focus:outline-none focus:ring-2 focus:ring-orange-500/60" />
    </div>
  </div>

  <!-- Detail description -->
  <div>
    <label for="detailDescription" class="text-xs text-slate-400">detail (markdown)</label>
    <textarea id="detailDescription" name="detailDescription" rows="8" class="mt-1 w-full rounded-xl bg-slate-900/60 border border-white/10 px-4 py-3 text-slate-100 focus:outline-none focus:ring-2 focus:ring-orange-500/60">{{item.detailDescription}}</textarea>
    <div class="mt-2">
      <label class="text-xs text-slate-500">or upload .md file (replaces textarea):</label>
      <input type="file" name="mdFile" accept=".md,.markdown,.txt" class="mt-1 block text-sm text-slate-400 file:mr-3 file:py-1.5 file:px-3 file:rounded-lg file:border file:border-white/10 file:bg-white/5 file:text-slate-200 file:text-xs hover:file:border-orange-500/50" />
    </div>
  </div>

  <!-- Install actions: Claude Code -->
  <fieldset class="border border-white/10 rounded-xl p-4">
    <legend class="text-xs font-semibold text-orange-400 px-2">Claude Code</legend>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
      <div class="md:col-span-2">
        <label class="text-xs text-slate-400">install command</label>
        <input name="claude_code_command" value="{{item.installActions.claude_code.command}}" class="mt-1 w-full rounded-xl bg-slate-900/60 border border-white/10 px-4 py-2.5 text-sm text-slate-100 focus:outline-none focus:ring-2 focus:ring-orange-500/60" />
      </div>
      <div>
        <label class="text-xs text-slate-400">url</label>
        <input name="claude_code_url" value="{{item.installActions.claude_code.url}}" class="mt-1 w-full rounded-xl bg-slate-900/60 border border-white/10 px-4 py-2.5 text-sm text-slate-100 focus:outline-none focus:ring-2 focus:ring-orange-500/60" />
      </div>
      <div>
        <label class="text-xs text-slate-400">config path</label>
        <input name="claude_code_path" value="{{item.installActions.claude_code.path}}" class="mt-1 w-full rounded-xl bg-slate-900/60 border border-white/10 px-4 py-2.5 text-sm text-slate-100 focus:outline-none focus:ring-2 focus:ring-orange-500/60" />
      </div>
      <div class="md:col-span-2">
        <label class="text-xs text-slate-400">notes</label>
        <input name="claude_code_notes" value="{{item.installActions.claude_code.notes}}" class="mt-1 w-full rounded-xl bg-slate-900/60 border border-white/10 px-4 py-2.5 text-sm text-slate-100 focus:outline-none focus:ring-2 focus:ring-orange-500/60" />
      </div>
    </div>
  </fieldset>

  <!-- Install actions: Cursor -->
  <fieldset class="border border-white/10 rounded-xl p-4">
    <legend class="text-xs font-semibold text-blue-400 px-2">Cursor</legend>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
      <div class="md:col-span-2">
        <label class="text-xs text-slate-400">install command</label>
        <input name="cursor_command" value="{{item.installActions.cursor.command}}" class="mt-1 w-full rounded-xl bg-slate-900/60 border border-white/10 px-4 py-2.5 text-sm text-slate-100 focus:outline-none focus:ring-2 focus:ring-orange-500/60" />
      </div>
      <div>
        <label class="text-xs text-slate-400">url (e.g. cursor:// deep link)</label>
        <input name="cursor_url" value="{{item.installActions.cursor.url}}" class="mt-1 w-full rounded-xl bg-slate-900/60 border border-white/10 px-4 py-2.5 text-sm text-slate-100 focus:outline-none focus:ring-2 focus:ring-orange-500/60" />
      </div>
      <div>
        <label class="text-xs text-slate-400">config path</label>
        <input name="cursor_path" value="{{item.installActions.cursor.path}}" class="mt-1 w-full rounded-xl bg-slate-900/60 border border-white/10 px-4 py-2.5 text-sm text-slate-100 focus:outline-none focus:ring-2 focus:ring-orange-500/60" />
      </div>
      <div class="md:col-span-2">
        <label class="text-xs text-slate-400">notes</label>
        <input name="cursor_notes" value="{{item.installActions.cursor.notes}}" class="mt-1 w-full rounded-xl bg-slate-900/60 border border-white/10 px-4 py-2.5 text-sm text-slate-100 focus:outline-none focus:ring-2 focus:ring-orange-500/60" />
      </div>
    </div>
  </fieldset>

  <div class="flex items-center gap-3">
    <button type="submit" class="px-5 py-2.5 rounded-xl bg-orange-500 text-black font-semibold hover:bg-orange-400">update</button>
    <a href="/items/{{item.itemId}}" class="text-sm text-slate-300 hover:text-white">cancel</a>
  </div>
</form>

<script>
(function() {
  var input = document.getElementById('icon');
  var btns = document.querySelectorAll('.emoji-btn');
  function highlight(val) {
    btns.forEach(function(b) {
      if (b.dataset.emoji === val) {
        b.classList.add('border-orange-400', 'bg-orange-500/20');
        b.classList.remove('border-white/10');
      } else {
        b.classList.remove('border-orange-400', 'bg-orange-500/20');
        b.classList.add('border-white/10');
      }
    });
  }
  btns.forEach(function(b) {
    b.addEventListener('click', function() {
      input.value = b.dataset.emoji;
      highlight(b.dataset.emoji);
    });
  });
  input.addEventListener('input', function() { highlight(input.value); });
})();
</script>
