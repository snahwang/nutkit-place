<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{title}} | Zarket Places</title>
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
  <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="stylesheet" href="/css/tailwind.css" />
  <style>
    emoji-picker {
      --background: #0f172a;
      --border-color: rgba(255,255,255,0.1);
      --input-border-color: rgba(255,255,255,0.1);
      --input-font-color: #e2e8f0;
      --input-placeholder-color: #64748b;
      --category-font-color: #94a3b8;
      --indicator-color: #f97316;
      --outline-color: #f97316;
      --button-active-background: rgba(249,115,22,0.2);
      --button-hover-background: rgba(255,255,255,0.08);
      border-radius: 0.75rem;
    }
  </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen">
  <!-- Top Nav -->
  <nav class="sticky top-0 z-20 border-b border-white/5 bg-slate-950/70 backdrop-blur">
    <div class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between">
      <div class="flex items-center gap-4">
        <a href="/" class="flex items-center gap-2 font-semibold tracking-tight">
          <span class="text-lg">Zarket Places</span>
          <span class="text-xs px-2 py-0.5 rounded-full bg-white/5 text-slate-300 border border-white/10">registry</span>
        </a>
      </div>

      <div class="flex items-center gap-3">
        <a href="/" class="text-sm text-slate-300 hover:text-white">browse</a>
        {{#if user}}
          <a href="/items/new" class="text-sm text-slate-300 hover:text-white">register</a>
          <span class="text-xs text-slate-500">{{user.name}}</span>
          <a href="/auth/logout" class="text-sm font-semibold px-3 py-1.5 rounded-lg bg-white/5 border border-white/10 text-slate-200 hover:border-orange-500/50">logout</a>
        {{else}}
          {{#unless authRequired}}
            <a href="/items/new" class="text-sm text-slate-300 hover:text-white">register</a>
          {{else}}
            <a href="/auth/google" class="text-sm font-semibold px-3 py-1.5 rounded-lg bg-orange-500 text-black hover:bg-orange-400">login</a>
          {{/unless}}
        {{/if}}
      </div>
    </div>
  </nav>

  <main class="max-w-6xl mx-auto px-4 py-10">
    {{{body}}}
  </main>

  <footer class="border-t border-white/5 mt-16">
    <div class="max-w-6xl mx-auto px-4 py-6 text-center text-sm text-slate-400">
      Zarket Places &copy; 2026
    </div>
  </footer>
</body>
</html>
